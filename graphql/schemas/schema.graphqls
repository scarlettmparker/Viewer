scalar DateTime

type Account {
  id: String!
  username: String!
  personId: ID!
  status: AccountStatus!
  provider: String
  createdAt: DateTime
  updatedAt: DateTime
}

enum AccountStatus {
  ACTIVE
  SUSPENDED
  PENDING
}

type AuthResult {
  accountId: ID!
  personId: ID!
  token: String!
}

input LoginInput {
  username: String!
  password: String!
}

type GaiaQueries {
  me: Account
  account(id: ID!): Account
  listAccounts: [Account!]
}

type LogoutResponse {
  message: String!
}

type GaiaMutations {
  login(input: LoginInput!): AuthResult
  logout: LogoutResponse!
}

extend type Query {
  gaiaQueries: GaiaQueries!
}

extend type Mutation {
  gaiaMutations: GaiaMutations!
}
